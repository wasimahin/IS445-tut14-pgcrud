<div class="form-horizontal">
    <div class="mb-3">
        <label class="form-label" for="title">Title</label>
        <input type="text" class="form-control" name="title" id="title" value="<%= model.title %>" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="author">Author</label>
        <input type="text" class="form-control" name="author" id="author" value="<%= model.author %>" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="comments">Comments</label>
        <textarea class="form-control" name="comments" id="comments" rows="3"><%= model.comments %></textarea>
    </div>
</div>
